# --- Application ---
APP_ENV=local                       # local | dev | prod
APP_NAME=svarog-core

# --- HTTP / gRPC listeners ---
GRPC_ADDR=:9090
HTTP_ADDR=:8080

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=svarog
POSTGRES_PASSWORD=svarog
POSTGRES_DB=svarog
POSTGRES_SSLMODE=disable

# Used by `make migrate` (golang-migrate CLI)
DB_DSN=postgres://svarog:svarog@localhost:5432/svarog?sslmode=disable

# --- Sessions ---
SESSION_COOKIE_NAME=sid
SESSION_TTL=24h
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false         # true in prod

# --- Observability (OpenTelemetry) ---
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=svarog-core
OTEL_SERVICE_VERSION=0.0.1

# --- Logging ---
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # json | text

# --- MCP (cmd/mcp-stdio, cmd/mcp-http) ---
MCP_HTTP_ADDR=:8000
SVAROG_HTTP_BASE=http://localhost:8080

# --- Context7 MCP (optional, higher rate limits) ---
# Get key: https://context7.com/dashboard
# Add to .cursor/mcp.json under context7.headers.CONTEXT7_API_KEY if needed
# CONTEXT7_API_KEY=
